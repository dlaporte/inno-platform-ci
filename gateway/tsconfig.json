{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"]
  },
  // NOTE: paths are relative to the DEPLOYED layout, not this repo. At build
  // time platform-ci builds the gateway in its own directory ($GW), with this
  // tsconfig at its root and the gateway sources in `$GW/src/gateway/`, so
  // `src` is correct there. (The copy platform-ci also puts at the app root
  // only serves the function-shaped app Worker's tsconfig lookup.) Inside
  // inno-platform the gateway lives at `gateway/*.ts` and is typechecked by the
  // ROOT tsconfig.json (`include: [... "gateway"]`); do not "fix" this to
  // `gateway` or it will typecheck nothing in the deployed layout. No `test`
  // entry and no test-runner types: the deployed layout has no test suite
  // (the gateway suite runs from the inno-platform root, vitest.config.gateway.ts).
  "include": ["src"]
}
